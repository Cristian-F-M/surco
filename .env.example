# Copia este archivo a ".env" y completa los valores.
# Los obtienes en Google Cloud Console (ver README.md).

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Debe coincidir EXACTAMENTE con el "Authorized redirect URI" configurado en Google Cloud.
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Opcional: permite buscar artistas/canciones SIN tener la sesión de YouTube conectada.
# Se crea en el mismo proyecto de Google Cloud: Credenciales -> Crear credenciales -> Clave de API.
# Si no la configuras, la búsqueda solo funciona mientras estés conectado con "Conectar con YouTube".
GOOGLE_API_KEY=

# Opcional, por defecto 3000
PORT=3000
